Modos  = {"PLA", "PETG"};

margen = [
  [2350 4150]          // PLA  (CLP por pieza)
  [2350 5650]          // PETG (CLP por pieza)
];
horas = [
  [0.75 1.45]          // PLA  (h por pieza)
  [1.05 1.9]           // PETG (h por pieza)
];

